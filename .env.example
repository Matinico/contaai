# Copiá este archivo como .env.local y completá los valores

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxx

# NextAuth — generá un secret con: openssl rand -base64 32
NEXTAUTH_SECRET=cambia-esto-por-un-string-aleatorio-largo
NEXTAUTH_URL=http://localhost:3000
# En Vercel, NEXTAUTH_URL se completa automáticamente. Solo necesitás NEXTAUTH_SECRET.
